import { IsOptional, IsPositive, IsInt, Min, Max, IsString } from 'class-validator';
import { Type } from 'class-transformer';

export class PaginationDto {
  @IsOptional()
  @Type(() => Number)
  @IsInt()
  @IsPositive()
  page?: number = 1;

  @IsOptional()
  @Type(() => Number)
  @IsInt()
  @Min(1)
  @Max(100)
  limit?: number = 10;
}

export class SearchDto {
  @IsOptional()
  @IsString()
  field?: string;

  @IsOptional()
  value?: any;
}

export class PaginatedSearchDto extends PaginationDto {
  @IsOptional()
  @IsString()
  field?: string;

  @IsOptional()
  value?: any;
}

